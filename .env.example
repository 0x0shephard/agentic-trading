# ── Sepolia RPC ──────────────────────────────────────────────────────────────
# Public node is fine for the read-only boot check; use a KEYED endpoint
# (Alchemy/Infura) once agents are actually trading, or it will rate-limit.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# ── Wallets (TESTNET ONLY — never a mainnet key/mnemonic) ─────────────────────
# All agent wallets are derived from this single HD mnemonic (index 0 = treasury).
AGENT_MNEMONIC=

# ── LLM (phase 4: macro agent + regime supervisor) ───────────────────────────
ANTHROPIC_API_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# DRY_RUN=true  → decisions are computed & simulated but NOT sent on-chain.
# Must be the literal string "true" or "false".
DRY_RUN=true
KILL_SWITCH=false

# ── Railway trading service ─────────────────────────────────────────────────
# 19 agents maps one wallet/agent loop onto each configured market.
RAILWAY_AGENT_COUNT=19
# Run continuously until Railway stops the service or KILL_SWITCH=true.
RAILWAY_RUN_CONTINUOUS=true
RAILWAY_PROVISION_ON_START=true
RAILWAY_GLOBAL_TPS=3
RAILWAY_RATE_MULTIPLIER=1
RAILWAY_CONTROLLER_SEC=30
RAILWAY_REPORT_SEC=60
