# ── Sepolia RPC ──────────────────────────────────────────────────────────────
# Public node is fine for the read-only boot check; use a KEYED endpoint
# (Alchemy/Infura) once agents are actually trading, or it will rate-limit.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# ── Wallet labels (read-only in the monitor service) ──────────────────────────
# Use the same TESTNET mnemonic as the trading swarm so wallet addresses can be
# labeled (mm-01, hft-01, etc.) and included in health checks. The monitor never
# signs transactions. Never use a mainnet mnemonic here.
AGENT_MNEMONIC=

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Keep this true for a monitor-only deployment. The monitor performs chain reads,
# Supabase alert writes, and Slack webhook calls; it does not submit chain txs.
DRY_RUN=true
KILL_SWITCH=false

# ── Supabase trade-flow surveillance ─────────────────────────────────────────
# Set these as Railway secrets. Never commit their real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONITOR_POLL_MS=45000
MONITOR_LOOKBACK_MIN=120
# Number of agent wallets to label/watch, excluding treasury index 0.
MONITOR_LABEL_WALLETS=19

# ── Protocol health monitoring ───────────────────────────────────────────────
HEALTH_POLL_MS=60000
HEARTBEAT_HOURS=24

# ── Admin-action watch (on-chain admin events + admin-key txs) ────────────────
ADMIN_POLL_MS=60000
# Extra admin addresses to watch, comma-separated (contract owners auto-included).
ADMIN_WATCH_ADDRESSES=

# ── Network / RPC health ─────────────────────────────────────────────────────
NET_POLL_MS=60000
# Optional second Sepolia endpoint. Strongly recommended: it lets the monitor
# tell "our provider is down" apart from "the chain has stalled".
NET_FALLBACK_RPC_URL=
NET_STALL_WARN_MS=180000
NET_STALL_CRIT_MS=600000
NET_LAG_BLOCKS=20

# ── Login / site health (gateway logs via Axiom + uptime probes) ─────────────
# AXIOM_API_TOKEN is a credential — set it as a Railway secret / local .env only,
# never commit the real value. It MUST have the Query permission on the dataset
# (a plain read token can only list datasets, not query them).
AXIOM_API_TOKEN=
AXIOM_DATASET=bytestrike-logs
SITE_POLL_MS=300000
SITE_WINDOW_MIN=15
SITE_MIN_SAMPLE=50
SITE_ERR5XX_WARN_PCT=2
SITE_ERR5XX_CRIT_PCT=10
SITE_ERR5XX_ABS_FLOOR=5
# 429 baseline is high (agents hammer the write tier), so these sit well above it.
SITE_RL_WARN_PCT=60
SITE_RL_CRIT_PCT=85
SITE_AUTHFAIL_IP_WARN=10
SITE_AUTHFAIL_IP_CRIT=30
# External uptime targets (optional; probed only if set). Use the LIVE URLs.
SITE_URL=https://byte-strike.com
SITE_API_HEALTH_URL=https://bytestrike-api-gateway.bytestrike.workers.dev/health


# ── Slack notifications ──────────────────────────────────────────────────────
# Set webhook URLs as Railway secrets. Critical alerts prefer the critical
# webhook; warnings prefer the alerts webhook, with fallback between them.
SLACK_WEBHOOK_CRITICAL=
SLACK_WEBHOOK_ALERTS=
ALERT_COOLDOWN_SEC=1800
ALERT_ON_START=true
