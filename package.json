{
  "name": "bytestrike-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Testnet trading-agent simulator for the ByteStrike GPU-futures exchange (Sepolia).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "gen:mnemonic": "tsx scripts/generate-mnemonic.ts",
    "wallets": "tsx scripts/show-wallets.ts",
    "poc": "tsx scripts/poc.ts",
    "flatten": "tsx scripts/flatten.ts",
    "provision": "tsx scripts/provision.ts",
    "treasury": "tsx scripts/treasury-status.ts",
    "agent": "tsx scripts/run-agent.ts",
    "swarm": "tsx scripts/run-swarm.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "viem": "^2.21.45",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
